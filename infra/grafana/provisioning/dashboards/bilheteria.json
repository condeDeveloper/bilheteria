{
  "title": "Bilheteria",
  "uid": "bilheteria",
  "schemaVersion": 39,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requisições por segundo por status",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (status) (rate(http_server_requests_seconds_count{uri=~\"/api/.*\"}[1m]))", "legendFormat": "{{status}}", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latência p95 por rota (s)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri=~\"/api/.*\"}[5m])))", "legendFormat": "{{uri}}", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Outbox pendente",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 5 },
      "targets": [{ "expr": "sum(bilheteria_outbox_pendentes)", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Mensagens publicadas",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 5 },
      "targets": [{ "expr": "sum(bilheteria_outbox_publicadas_total)", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Circuit breaker pagamentos",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 5 },
      "targets": [{ "expr": "max(resilience4j_circuitbreaker_state{name=\"pagamentos\", state=\"open\"})", "refId": "A" }],
      "options": { "colorMode": "background" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "fechado", "color": "green" }, "1": { "text": "ABERTO", "color": "red" } } }] } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Lag dos consumidores",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 5 },
      "targets": [{ "expr": "sum by (group) (kafka_consumer_fetch_manager_records_lag_max)", "legendFormat": "{{group}}", "refId": "A" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "JVM: heap usado e threads",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 7 },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "heap", "refId": "A" },
        { "expr": "sum(jvm_threads_live_threads)", "legendFormat": "threads", "refId": "B" }
      ]
    }
  ]
}
